{
  "name": "lll-scheduler",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:start": "npm run backend:build && node backend/dist/src/server.js",
    "backend:test": "npm run backend:build && node --test backend/dist/tests/*.test.js",
    "backend:test:postgres": "npm run backend:build && node --test backend/dist/tests/*.integration.js",
    "db:migrate": "npm run backend:build && node backend/dist/src/db/migrate.js",
    "db:seed:demo": "npm run backend:build && node backend/dist/src/db/seed-demo.js"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.6.3"
  }
}
